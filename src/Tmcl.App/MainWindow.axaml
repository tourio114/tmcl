<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Tmcl.App.MainWindow"
        Title="TMCL · Minecraft Launcher" Width="1140" Height="820" MinWidth="920" MinHeight="660" Background="{DynamicResource PageBrush}">
  <Grid ColumnDefinitions="224,*">
    <Border Padding="12,28,12,20" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="12,0,0,32">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border x:Name="FluentBrand" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentBrush}"><Path Data="M7,8 L25,8 L25,12 L18,12 L18,25 L14,25 L14,12 L7,12 Z" Fill="{DynamicResource AccentInkBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <Border x:Name="ClaudeBrand" IsVisible="False" Width="32" Height="32" CornerRadius="7" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5"><TextBlock Text="T" FontSize="21" FontFamily="Georgia" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <TextBlock Text="TMCL" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Minecraft 启动器" FontSize="12" Classes="muted"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="12,24,0,0">
          <TextBlock Text="Minecraft Java Edition" FontSize="10" Classes="muted"/>
          <TextBlock Text="版本 0.10.0" FontSize="11" Classes="muted"/>
        </StackPanel>
        <StackPanel Spacing="6">
          <Button x:Name="GameNavButton" Classes="nav selected" Click="GamePageClick"><StackPanel Orientation="Horizontal" Spacing="14"><Path Data="M3,10 L12,3 L21,10 M5,9 L5,21 L10,21 L10,14 L14,14 L14,21 L19,21 L19,9" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform"/><TextBlock Text="开始游戏" VerticalAlignment="Center"/></StackPanel></Button>
          <Button x:Name="SettingsNavButton" Classes="nav" Click="SettingsPageClick"><StackPanel Orientation="Horizontal" Spacing="14"><Path Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18 M8,3 L8,9 M16,9 L16,15 M10,15 L10,21" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform"/><TextBlock Text="启动器设置" VerticalAlignment="Center"/></StackPanel></Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <StackPanel Margin="{DynamicResource PageHeaderMargin}" Spacing="8">
        <TextBlock Text="TMCL" Classes="muted" FontSize="12"/>
        <TextBlock x:Name="PageTitle" Text="开始游戏" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock x:Name="PageSubtitle" Text="管理游戏版本与账号，启动 Minecraft。" Classes="muted"/>
      </StackPanel>
      <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{DynamicResource PageContentMargin}">
          <StackPanel x:Name="GameView" Spacing="24">
            <Border Classes="card">
              <StackPanel Spacing="20">
                <StackPanel Spacing="6"><TextBlock Text="游戏版本" Classes="section"/><TextBlock Text="选择要下载或启动的 Minecraft 版本。" Classes="muted" FontSize="13"/></StackPanel>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <ComboBox x:Name="VersionBox" HorizontalAlignment="Stretch" PlaceholderText="选择 Minecraft 版本"/>
                  <CheckBox Grid.Column="1" x:Name="SnapshotBox" Content="显示快照" Margin="16,0" IsCheckedChanged="FilterChanged"/>
                  <Button Grid.Column="2" x:Name="RefreshButton" Content="刷新" Click="RefreshClick"/>
                </Grid>
                <CheckBox x:Name="LocalOnlyBox" Content="断网启动，只使用本地已安装的游戏"/>
                <Border Height="1" Background="{DynamicResource LineBrush}"/>
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <TextBlock Text="缺少的游戏文件与 Java 将自动下载。" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                  <Button Grid.Column="1" x:Name="DownloadButton" Content="下载 / 修复" Click="DownloadClick" Margin="0,0,12,0"/>
                  <Button Grid.Column="2" x:Name="LaunchButton" Content="启动游戏" Click="LaunchClick" Classes="primary" MinWidth="144"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="20">
                <StackPanel Spacing="6"><TextBlock Text="游戏账号" Classes="section"/><TextBlock Text="使用离线用户名开始单人游戏，或登录你的微软账号。" Classes="muted" FontSize="13"/></StackPanel>
                <Grid ColumnDefinitions="*,*">
                  <StackPanel Spacing="8" Margin="0,0,8,0"><TextBlock Text="账号类型" Classes="label"/><ComboBox x:Name="AccountModeBox" SelectedIndex="0" HorizontalAlignment="Stretch"><ComboBoxItem Content="离线账号"/><ComboBoxItem Content="微软账号"/></ComboBox></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="8" Margin="8,0,0,0"><TextBlock Text="离线用户名" Classes="label"/><TextBox x:Name="OfflineNameBox" Watermark="3–16 位英文、数字或下划线"/></StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource LineBrush}"/>
                <TextBlock x:Name="AccountText" Text="微软账号未登录，离线账号可直接使用。" Classes="muted" FontSize="12"/>
                <WrapPanel Orientation="Horizontal"><Button x:Name="LoginButton" Content="登录微软账号" Click="LoginClick" Margin="0,0,8,8"/><Button x:Name="SwitchAccountButton" Content="切换微软账号" Click="SwitchAccountClick" Margin="0,0,8,8"/><Button x:Name="LogoutButton" Content="退出" Click="LogoutClick" Margin="0,0,8,8"/><Button x:Name="ConfigureLoginButton" Content="配置微软登录" Click="ConfigureLoginClick" Margin="0,0,0,8"/></WrapPanel>
                <SelectableTextBlock x:Name="AuthStatusText" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel x:Name="AuthCodePanel" IsVisible="False" Spacing="8">
                  <TextBlock Text="微软验证地址与登录代码" Classes="label"/>
                  <SelectableTextBlock x:Name="AuthVerificationText" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="200,Auto"><TextBox x:Name="AuthCodeBox" IsReadOnly="True" FontSize="20" FontWeight="SemiBold"/><Button Grid.Column="1" x:Name="OpenVerificationButton" Content="打开微软验证页面" Click="OpenVerificationClick" Margin="12,0,0,0"/></Grid>
                  <TextBlock Text="只在微软验证页面输入代码。等待授权期间请保持启动器打开，可随时取消。" Classes="muted" FontSize="12"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="在「启动器设置」中调整主题、Java、内存与下载源。" Classes="muted" FontSize="12" Margin="4,0"/>
          </StackPanel>
          <StackPanel x:Name="SettingsView" IsVisible="False" Spacing="24">
            <StackPanel Spacing="12">
              <TextBlock Text="外观" Classes="section"/>
              <Border Classes="card">
                <Grid ColumnDefinitions="32,*,220">
                  <Path Data="M3,4 L21,4 L21,17 L3,17 Z M8,21 L16,21 M12,17 L12,21 M8,8 L16,8 M8,12 L13,12" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="12,0,24,0"><TextBlock Text="界面风格" FontWeight="SemiBold"/><TextBlock Text="选择喜欢的配色、间距与界面细节。" Classes="muted" FontSize="12"/></StackPanel>
                  <ComboBox Grid.Column="2" x:Name="StyleBox" HorizontalAlignment="Stretch" VerticalAlignment="Center"><ComboBoxItem Content="Fluent 2"/><ComboBoxItem Content="Claude · 简约暖色"/></ComboBox>
                </Grid>
              </Border>
              <Border Classes="card">
                <Grid ColumnDefinitions="32,*,220">
                  <Path Data="M12,3 C7,3 3,7 3,12 C3,17 7,21 12,21 C15,21 14,17 17,17 C22,17 22,10 18,6 C16,4 14,3 12,3 Z M7,10 L7.1,10 M11,7 L11.1,7 M16,8 L16.1,8" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="12,0,24,0"><TextBlock Text="应用主题" FontWeight="SemiBold"/><TextBlock Text="选择浅色、深色，或与系统保持一致。" Classes="muted" FontSize="12"/></StackPanel>
                  <ComboBox Grid.Column="2" x:Name="ThemeBox" HorizontalAlignment="Stretch" VerticalAlignment="Center"><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/><ComboBoxItem Content="跟随系统"/></ComboBox>
                </Grid>
              </Border>
            </StackPanel>
            <StackPanel x:Name="SettingsPanel" Spacing="24">
              <StackPanel Spacing="12">
                <TextBlock Text="游戏与运行环境" Classes="section"/>
                <StackPanel Spacing="4">
                  <Border Classes="card"><StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="游戏目录" FontWeight="SemiBold"/><TextBlock Text="游戏版本、资源和存档的保存位置。" Classes="muted" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="选择目录" Click="FolderClick" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
                    <TextBox x:Name="PathBox"/>
                  </StackPanel></Border>
                  <Border Classes="card"><StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4" Margin="0,0,16,0"><TextBlock Text="Java" FontWeight="SemiBold"/><TextBlock Text="留空时自动检测并安装匹配的 OpenJDK。" Classes="muted" FontSize="12"/></StackPanel><Button Grid.Column="1" Content="检测 / 安装" Click="JavaCheckClick" VerticalAlignment="Center"/></Grid>
                    <Grid ColumnDefinitions="*,Auto"><TextBox x:Name="JavaBox" Watermark="自动管理 Java"/><Button Grid.Column="1" Content="选择文件" Click="JavaClick" Margin="12,0,0,0"/></Grid>
                    <TextBlock x:Name="JavaStatusText" Text="启动时会自动检查 Java 版本与架构。" Classes="muted" FontSize="12"/>
                  </StackPanel></Border>
                  <Border Classes="card"><Grid ColumnDefinitions="*,180"><StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="最大游戏内存" FontWeight="SemiBold"/><TextBlock Text="分配给游戏的内存上限，单位 MB。" Classes="muted" FontSize="12"/></StackPanel><NumericUpDown Grid.Column="1" x:Name="MemoryBox" Minimum="512" Maximum="65536" Increment="512" VerticalAlignment="Center"/></Grid></Border>
                </StackPanel>
              </StackPanel>
              <StackPanel Spacing="12">
                <TextBlock Text="下载" Classes="section"/>
                <StackPanel Spacing="4">
                  <Border Classes="card"><StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,240"><StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="下载源" FontWeight="SemiBold"/><TextBlock Text="自动选择或手动指定游戏下载源。" Classes="muted" FontSize="12"/></StackPanel><ComboBox Grid.Column="1" x:Name="SourceBox" HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="自动推荐"/><ComboBoxItem Content="BMCLAPI 镜像"/><ComboBoxItem Content="官方源"/></ComboBox></Grid>
                    <Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="SourceStatusText" Text="中国 IPv4 默认 BMCLAPI，测速后优先更快的源。" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Grid.Column="1" Content="检测 IPv4 并测速" Click="SpeedTestClick"/></Grid>
                  </StackPanel></Border>
                  <Border Classes="card"><Grid ColumnDefinitions="*,180"><StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="并发下载数" FontWeight="SemiBold"/><TextBlock Text="同时下载的文件数，范围为 1–32。" Classes="muted" FontSize="12"/></StackPanel><NumericUpDown Grid.Column="1" x:Name="ThreadsBox" Minimum="1" Maximum="32" VerticalAlignment="Center"/></Grid></Border>
                </StackPanel>
              </StackPanel>
              <StackPanel Spacing="12">
                <TextBlock Text="账号" Classes="section"/>
                <Border Classes="card"><StackPanel Spacing="12">
                  <StackPanel Spacing="4"><TextBlock Text="微软登录应用 ID" FontWeight="SemiBold"/><TextBlock Text="可选。离线账号无需填写；申请方法见仓库 README。" Classes="muted" FontSize="12"/></StackPanel>
                  <TextBox x:Name="ClientBox" Watermark="Microsoft OAuth Client ID（公开应用标识，不是密钥）"/>
                  <TextBlock Text="桌面应用回调：http://localhost；账号类型：个人 Microsoft 账号。Minecraft API 访问权限需要另外确认。" Classes="muted" FontSize="12"/>
                  <Grid ColumnDefinitions="*,240"><StackPanel Spacing="4" VerticalAlignment="Center" Margin="0,0,24,0"><TextBlock Text="微软登录方式" FontWeight="SemiBold"/><TextBlock Text="浏览器回调不可用时，可改用设备代码。" Classes="muted" FontSize="12"/></StackPanel><ComboBox Grid.Column="1" x:Name="LoginMethodBox" HorizontalAlignment="Stretch"><ComboBoxItem Content="系统浏览器（推荐）"/><ComboBoxItem Content="设备代码"/></ComboBox></Grid>
                </StackPanel></Border>
              </StackPanel>
              <Button Content="保存设置" Click="SaveSettingsClick" Classes="primary" HorizontalAlignment="Right" MinWidth="120"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="{DynamicResource FooterPadding}" Background="{DynamicResource PageBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
        <StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="StatusText" Text="一切就绪。" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Grid.Column="1" x:Name="CancelButton" Content="取消任务" IsEnabled="False" Click="CancelClick"/></Grid><ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="3"/></StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
