<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Tmcl.App.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <Thickness x:Key="CardPadding">20</Thickness>
      <CornerRadius x:Key="CardRadius">6</CornerRadius>
      <Thickness x:Key="ControlPadding">14,8</Thickness>
      <x:Double x:Key="ControlHeight">36</x:Double>
      <Thickness x:Key="PageHeaderMargin">32,28,32,24</Thickness>
      <Thickness x:Key="PageContentMargin">32,0,32,24</Thickness>
      <Thickness x:Key="FooterPadding">32,12,32,16</Thickness>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBrush" Color="#F3F3F3"/>
          <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F3"/>
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="InsetBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="LineBrush" Color="#E5E5E5"/>
          <SolidColorBrush x:Key="InkBrush" Color="#1A1A1A"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#606060"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
          <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SelectedBrush" Color="#E6E6E6"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBrush" Color="#202020"/>
          <SolidColorBrush x:Key="SidebarBrush" Color="#202020"/>
          <SolidColorBrush x:Key="SurfaceBrush" Color="#2B2B2B"/>
          <SolidColorBrush x:Key="InsetBrush" Color="#1F1F1F"/>
          <SolidColorBrush x:Key="LineBrush" Color="#3D3D3D"/>
          <SolidColorBrush x:Key="InkBrush" Color="#F5F5F5"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#BDBDBD"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
          <SolidColorBrush x:Key="AccentInkBrush" Color="#00324C"/>
          <SolidColorBrush x:Key="SelectedBrush" Color="#383838"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0067C0"/>
        <ColorPaletteResources x:Key="Dark" Accent="#60CDFF"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontSize" Value="14"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/><Setter Property="Padding" Value="{DynamicResource CardPadding}"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="{DynamicResource ControlPadding}"/><Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/><Setter Property="Background" Value="{DynamicResource InsetBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Opacity" Value="0.88"/></Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Opacity" Value="0.75"/></Style>
    <Style Selector="Button.nav"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="14,10"/></Style>
    <Style Selector="Button.nav.selected"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.nav.selected"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="3,0,0,0"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6"/><Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/><Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="{DynamicResource InsetBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="6"/><Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/><Setter Property="Background" Value="{DynamicResource InsetBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
    <Style Selector="NumericUpDown"><Setter Property="CornerRadius" Value="6"/><Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/><Setter Property="Background" Value="{DynamicResource InsetBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource LineBrush}"/></Style>
  </Application.Styles>
</Application>
