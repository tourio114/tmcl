<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Tmcl.App.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <Thickness x:Key="CardPadding">20</Thickness>
      <CornerRadius x:Key="CardRadius">8</CornerRadius>
      <CornerRadius x:Key="ControlRadius">4</CornerRadius>
      <BoxShadows x:Key="CardShadow">0 1 2 0 #10000000</BoxShadows>
      <Thickness x:Key="ControlPadding">12,8</Thickness>
      <x:Double x:Key="ControlHeight">36</x:Double>
      <Thickness x:Key="PageHeaderMargin">32,28,32,24</Thickness>
      <Thickness x:Key="PageContentMargin">32,0,32,24</Thickness>
      <Thickness x:Key="FooterPadding">32,12,32,16</Thickness>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PageBrush" Color="#FAFAFA"/>
          <SolidColorBrush x:Key="SidebarBrush" Color="#F0F0F0"/>
          <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="InsetBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="LineBrush" Color="#E0E0E0"/>
          <SolidColorBrush x:Key="InkBrush" Color="#242424"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#616161"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD"/>
          <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="SelectedBrush" Color="#EBF3FC"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PageBrush" Color="#1F1F1F"/>
          <SolidColorBrush x:Key="SidebarBrush" Color="#141414"/>
          <SolidColorBrush x:Key="SurfaceBrush" Color="#292929"/>
          <SolidColorBrush x:Key="InsetBrush" Color="#242424"/>
          <SolidColorBrush x:Key="LineBrush" Color="#424242"/>
          <SolidColorBrush x:Key="InkBrush" Color="#FFFFFF"/>
          <SolidColorBrush x:Key="MutedBrush" Color="#ADADAD"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#479EF5"/>
          <SolidColorBrush x:Key="AccentInkBrush" Color="#0A1B2C"/>
          <SolidColorBrush x:Key="SelectedBrush" Color="#0A2E4A"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#0F6CBD"/>
        <ColorPaletteResources x:Key="Dark" Accent="#479EF5"/>
      </FluentTheme.Palettes>
    </FluentTheme>
    <Style Selector="Window"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontSize" Value="14"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="22"/></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/><Setter Property="Padding" Value="{DynamicResource CardPadding}"/><Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/><Setter Property="Padding" Value="{DynamicResource ControlPadding}"/><Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/><Setter Property="Background" Value="{DynamicResource InsetBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Opacity" Value="0.88"/></Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Opacity" Value="0.75"/></Style>
    <Style Selector="Button.nav"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="3,0,0,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Padding" Value="14,10"/></Style>
    <Style Selector="Button.nav.selected"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style Selector="Button.nav.selected"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="3,0,0,0"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/><Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/><Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="{DynamicResource InsetBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/><Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/><Setter Property="Background" Value="{DynamicResource InsetBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
    <Style Selector="NumericUpDown"><Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}"/><Setter Property="MinHeight" Value="{DynamicResource ControlHeight}"/><Setter Property="Background" Value="{DynamicResource InsetBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style>
    <Style Selector="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="{DynamicResource LineBrush}"/></Style>
  </Application.Styles>
</Application>
