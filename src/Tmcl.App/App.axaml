<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Tmcl.App.App" RequestedThemeVariant="Dark">
 <Application.Styles><FluentTheme/><Style Selector="Button"><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="16,10"/></Style><Style Selector="TextBox"><Setter Property="CornerRadius" Value="6"/></Style><Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="24"/></Style></Application.Styles>
</Application>
